<?xml version="1.0" encoding="UTF-8"?>
<itop_design xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="1.6">
  <classes>
    <!-- EXTEND USER REQUEST -->
    <class id="UserRequest" _delta="if_exists">
      <fields>
        <field id="access_level_name" xsi:type="AttributeString" _delta="define">
          <sql>access_level_name</sql>
          <is_null_allowed>false</is_null_allowed>
          <max_length>255</max_length>
        </field>
        <field id="access_level_id" xsi:type="AttributeInteger" _delta="define">
          <sql>access_level_id</sql>
          <is_null_allowed>true</is_null_allowed>
          <default_value>0</default_value>
        </field>
      </fields>
      <presentation>
        <details>
          <items>
            <item id="access_level_name" _delta="define">
              <rank>80</rank>
            </item>
          </items>
        </details>
      </presentation>
    </class>
    <!-- NEW CLASS For store rquest id and acces level Id-->
    <class id="UserRequestAccessLevel" _delta="define">
      <parent>cmdbAbstractObject</parent>
      <properties>
        <category>bizmodel,searchable</category>
        <key_type>autoincrement</key_type>
        <db_table>userrequest_access_level</db_table>
        <db_key_field>id</db_key_field>
        <name_attcode>name</name_attcode>
      </properties>
      <fields>
        <field id="name" xsi:type="AttributeString" _delta="define">
          <sql>name</sql>
          <is_null_allowed>true</is_null_allowed>
          <max_length>255</max_length>
        </field>
        <field id="request_id" xsi:type="AttributeExternalKey" _delta="define">
          <sql>request_id</sql>
          <target_class>UserRequest</target_class>
          <is_null_allowed>false</is_null_allowed>
          <on_target_delete>DEL_MANUAL</on_target_delete>
        </field>
        <field id="accesslevel_id" xsi:type="AttributeInteger" _delta="define">
          <sql>accesslevel_id</sql>
          <is_null_allowed>false</is_null_allowed>
          <default_value>0</default_value>
        </field>
      </fields>
      <methods />
      <presentation>
        <details>
          <items>
            <item id="name">
              <rank>10</rank>
            </item>
            <item id="request_id">
              <rank>20</rank>
            </item>
            <item id="accesslevel_id">
              <rank>30</rank>
            </item>
          </items>
        </details>
        <list>
          <items>
            <item id="name">
              <rank>10</rank>
            </item>
            <item id="request_id">
              <rank>20</rank>
            </item>
            <item id="accesslevel_id">
              <rank>30</rank>
            </item>
          </items>
        </list>
        <search>
          <items>
            <item id="name" />
            <item id="request_id" />
          </items>
        </search>
      </presentation>
    </class>
  </classes>
</itop_design>